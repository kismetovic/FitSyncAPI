# FITSync - Docker Compose environment template.
# Copy to .env and fill in real values. .env must never be committed.

# --- Database ---
# Per the assignment rules the database is named after the index number, without "IB".
DB_NAME=200270
SA_PASSWORD=ChangeMe_Strong#Passw0rd

# --- JWT ---
# Must be at least 32 characters. The API refuses to start without it, and it is
# deliberately absent from appsettings.json so no valid signing key lives in source.
JWT_SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
JWT_ISSUER=FitSyncApi
JWT_AUDIENCE=FitSyncClients
JWT_EXPIRES=7.00:00:00

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_EMAIL_QUEUE=fitsync-emails

# --- SMTP (consumed by the worker service only) ---
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_FROM_EMAIL=noreply@fitsyncdemo.com
SMTP_FROM_NAME=FITSync
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=false

# --- PayPal sandbox ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=https://example.com/paypal/return
PAYPAL_CANCEL_URL=https://example.com/paypal/cancel

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000,http://localhost:4200,https://localhost:4200,http://localhost:5000
